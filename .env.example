# ---------------------------------------------------------------
# ScriptDocs environment
# ---------------------------------------------------------------

# Postgres connection string.
# On Render this is wired automatically from the database.
# For local development, copy the *External* connection string from
# your database's page in the Render dashboard.
DATABASE_URL=

# Secret used to sign session cookies. Generate one with:
#   openssl rand -hex 32
# Changing it signs everybody out.
JWT_SECRET=

# Port the server listens on (Render sets this automatically)
PORT=3000

# --- optional ---
# How long a session cookie lasts
# SESSION_DAYS=30
# Delay after the last edit before the document is written to Postgres
# PERSIST_DEBOUNCE_MS=2000
# Hard ceiling between writes during continuous typing
# PERSIST_MAX_WAIT_MS=10000
# How long an empty document stays in memory before being dropped
# ROOM_IDLE_MS=30000
# How much editing time one automatic version covers
# VERSION_INTERVAL_MS=180000
# Automatic versions kept per script (named ones are never pruned)
# AUTO_VERSION_LIMIT=40
